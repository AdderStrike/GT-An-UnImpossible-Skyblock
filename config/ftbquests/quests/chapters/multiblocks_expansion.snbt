			x: -2.0d
			y: -1.0d
		}
		{
			description: [
				"The Twist:"
				""
				"Oxoflare: The multiblock uses 1 bucket of oxygen per item. In exchange, the voltage required goes down by 2 levels. (Any ULV or LV Recipes work for free) Any energy-free recipes also use 1 bucket of oxygen just as a heads up."
			]
			id: "3180C990569DE8B1"
