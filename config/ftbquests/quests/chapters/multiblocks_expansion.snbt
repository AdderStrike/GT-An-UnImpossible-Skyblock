		}
		{
			description: [
				"The twist:"
				""
				"Productive Power Consumption: This multiblock takes 4x inputs and gives 4x outputs at all times. Power consumption is proportionate and as such, only up to EV recipes are allowed."
			]
			id: "1760C446F4114914"
