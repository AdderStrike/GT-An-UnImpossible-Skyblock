			x: -0.5d
			y: -1.0d
		}
		{
			description: [
				"The Twist:"
				""
				"Advanced Machinery: The multiblock requires omnidirectional conveyors and MV components to make. However, recipes work one voltage tier down (ULV is free) and cleanroom requirements are waived as long as a primitive infrared component is used."
			]
			id: "739A8B9CF53AEC6E"
