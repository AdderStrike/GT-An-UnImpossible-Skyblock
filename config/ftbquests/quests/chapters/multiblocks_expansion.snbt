			y: -4.0d
		}
		{
			description: [
				"HI (High-Intensity) Multiblocks are powerful starting-game-multiblocks! They take LV tier machines and expand their capacities!"
				""
				"-Up to EIGHT Energy Hatches!"
				"-Up to IV (or said) recipes!"
				"-Unique Twists!"
			]
			id: "5FCEC465FCEDC027"
			tasks: [{
				id: "41717307855B0915"
