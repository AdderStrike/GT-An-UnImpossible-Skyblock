				type: "checkmark"
			}]
			x: -3.5d
			y: -1.0d
		}
		{
			description: [
				"The Twist:"
				""
				"Heated Efficiency: This multiblock requires fuel to operate at 100% efficiency, otherwise the machine runs at 50% efficiency."
			]
			id: "4B36D04F7034E776"
			tasks: [{
				id: "09D07DD06A477692"
				title: "HI Furnace"
				type: "checkmark"
			}]
