# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicitly treat these as text with LF
*.json text eol=lf
*.jsonc text eol=lf
*.json5 text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.properties text eol=lf
*.mcmeta text eol=lf

# Binary files - don't touch these at all
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.nbt binary